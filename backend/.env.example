# Use a comma-separated allow-list; do not use a wildcard in production.
SIGLER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VSRS_MODEL_PATH=backend/models/vsrs/mlp/model.joblib
# Hugging Face Storage Buckets are mutable. The setup manifest records each download.
# Leave empty until a threshold is validated on representative, signer-separated data.
VSRS_MIN_CONFIDENCE=
VSRS_SESSION_TTL_SECONDS=120
